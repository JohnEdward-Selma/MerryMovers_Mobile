<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    tools:context=".features.auth.RegisterActivity">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_back_button"
        android:contentDescription="@string/back_button"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back"
        app:tint="#0B5F5A" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/create_account_title"
        android:textColor="#000000"
        android:textSize="30sp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/create_account_subtitle"
        android:textColor="#4B5563"
        android:textSize="16sp" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

            <!-- Full Name Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/full_name"
                android:textColor="#000000"
                android:textSize="14sp" />

            <!-- Full Name Input -->
            <EditText
                android:id="@+id/et_full_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:maxWidth="360dp"
                android:autofillHints="personName"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="@string/full_name_hint"
                android:importantForAutofill="yes"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#374151"
                android:textSize="14sp" />

            <!-- Email Address Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/email_address"
                android:textColor="#000000"
                android:textSize="14sp" />

            <!-- Email Input -->
            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:maxWidth="360dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:hint="@string/email_hint"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#374151"
                android:textSize="14sp" />

            <!-- Password Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/password"
                android:textColor="#000000"
                android:textSize="14sp" />

            <!-- Password Input -->
            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:maxWidth="360dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_password"
                android:drawableEnd="@drawable/ic_visibility"
                android:drawablePadding="12dp"
                android:hint="@string/create_password_hint"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#374151"
                android:textSize="14sp" />

            <!-- Confirm Password Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/confirm_password"
                android:textColor="#000000"
                android:textSize="14sp" />

            <!-- Confirm Password Input -->
            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal"
                android:maxWidth="360dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_password"
                android:drawableEnd="@drawable/ic_visibility"
                android:drawablePadding="12dp"
                android:hint="@string/confirm_password_hint"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#374151"
                android:textSize="14sp" />

            <!-- Terms and Privacy Checkbox -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/i_agree"
                        android:textColor="#4B5563"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/terms_and_conditions"
                        android:textColor="#127D76"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/and_text"
                        android:textColor="#4B5563"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_privacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/privacy_policy"
                        android:textColor="#127D76"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

    </LinearLayout>

    <!-- Create Account Button -->
    <Button
        android:id="@+id/btn_create_account"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:layout_gravity="center_horizontal"
        android:maxWidth="360dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/create_account"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="DuplicateSpeakableTextCheck" />

    <!-- Or Sign Up With Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:text="@string/or_sign_up_with"
        android:textColor="#4B5563"
        android:textSize="14sp" />

    <!-- Social Login Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        style="?android:attr/buttonBarStyle"
        android:layout_gravity="center_horizontal"
        android:maxWidth="360dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="10dp">

        <!-- Google Button -->
        <Button
            android:id="@+id/btn_google"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="8dp"
            android:text="@string/google"
            android:textColor="#000000"
            android:textSize="14sp" />

        <!-- Facebook Button -->
        <Button
            android:id="@+id/btn_facebook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_facebook"
            android:drawablePadding="8dp"
            android:text="@string/facebook"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sign In Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/already_have_account"
            android:textColor="#4B5563"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/sign_in"
            android:textColor="#127D76"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
